{
  "name": "portfolio",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.16.0"
  },
  "scripts": {
    "halcyon": "node tools/halcyon.mjs",
    "model:pi": "node tools/publish-model.mjs",
    "media": "node tools/copy-sources.mjs && node tools/halcyon.mjs && node tools/covers.mjs && node tools/capture-halcyon.mjs && node tools/publish-media.mjs && node tools/publish-layers.mjs && node tools/publish-model.mjs && node tools/check-media.mjs",
    "layers:dead-tired": "node tools/publish-layers.mjs",
    "led:reference": "python tools/led-reference.py public/projects/pico-light-show/boot.py 1543 5030 tests/fixtures/boot-reference.json",
    "video:halcyon": "node tools/capture-halcyon-video.mjs",
    "video:ascii": "node tools/capture-ascii-demo.mjs",
    "check": "node tools/check-content.mjs",
    "posters": "vite build && node tools/posters.mjs",
    "poster:model": "vite build && node tools/model-poster.mjs",
    "to-webp": "node tools/to-webp.mjs",
    "check:media": "node tools/check-media.mjs",
    "check:history": "node tools/check-history.mjs",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource/big-shoulders-display": "5.3.0",
    "@fontsource/hanken-grotesk": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/michroma": "5.3.0",
    "lenis": "1.3.11",
    "three": "0.181.0"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/noto-sans-jp": "5.3.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.61.1",
    "axe-core": "4.14.0",
    "ffmpeg-static": "5.2.0",
    "meshoptimizer": "0.25.0",
    "sharp": "0.32.6",
    "vite": "6.4.1",
    "vitest": "3.2.4"
  },
  "overrides": {
    "ndarray-pixels": {
      "sharp": "$sharp"
    }
  }
}
